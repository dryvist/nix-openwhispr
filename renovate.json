{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^release\\.json$"],
      "matchStrings": [
        "\"upstreamVersion\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "OpenWhispr/openwhispr",
      "versioningTemplate": "semver"
    }
  ],
  "extends": ["github>JacobPEvans/.github:renovate-nix"]
}
